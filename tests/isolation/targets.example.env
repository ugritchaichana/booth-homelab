# One row per target: label=scope kind host port expect expect_red control
#   scope       all | runner | lxc | vm | cache (which probe guest runs the row; runner = lxc and vm, not the cache container; cache = only inside the cache container)
#   kind        tcp | tcp6 | tcpvia (tcpvia routes the peer through the gateway first, as root)
#   expect      open | blocked, with the guest firewall on
#   expect_red  open | blocked | refused, with `pve-firewall stop` (phase red-first); refused = the path is open but no service listens, an immediate reset
#   control     True when a working connection to the same target was measured elsewhere
#               (Test-R15Controls.ps1 from Windows, or the red-first run); False or - otherwise;
#               channel:<guest> is replaced by r15-verify.yml with True or False from the host's
#               own connection to that guest in the same run
# A blocked row that opens or answers with a reset fails whatever its control; one that is
# silent without control True prints NOT MEASURED and is not counted.
# Guest-to-guest: port isolation survives pve-firewall stop, so the direct row stays blocked in
# phase red-first; the via-gateway row is the path that bypasses it (HYPOTHESIS: also blocked,
# the reply returns directly between the isolated ports - the first red-first run decides).
# A service that is simply off looks like a block only if the probe cannot tell them apart: an absent
# service answers a reset at once (refused) while a firewall drop stays silent, so a blocked row that is
# dropped with the firewall on and refused with it off (expect_red refused) is a filter, not an absence.
# Cache rows are not listed here: CACHE_ADDR and CACHE_PORT in the environment add a positive
# "cache port reachable" row and a negative "cache tcp/22 blocked" row for runner guests, and
# the tcp/22 row is paired with the reachable one. Run with --guest cache inside the cache
# container, where those two rows are skipped and the existing negatives and cache-scope rows apply.
# Copy to targets.env (ignored by git) and replace the documentation addresses.
egress_public_https=all tcp 1.1.1.1 443 open open -
gateway_ssh=all tcp 192.0.2.1 22 blocked open True
gateway_web_console=all tcp 192.0.2.1 8006 blocked open True
management_ssh=all tcp 192.0.2.2 22 blocked open True
management_web_console=all tcp 192.0.2.2 8006 blocked open True
lxc_to_vm_direct=lxc tcp 192.0.2.22 22 blocked blocked channel:vm
lxc_to_vm_via_gateway=lxc tcpvia 192.0.2.22 22 blocked blocked channel:vm
vm_to_lxc_direct=vm tcp 192.0.2.21 22 blocked blocked channel:lxc
vm_to_lxc_via_gateway=vm tcpvia 192.0.2.21 22 blocked blocked channel:lxc
gateway_ssh_link_local=all tcp6 fe80::1%eth0 22 blocked open True
windows_host_smb=all tcp 198.51.100.1 445 blocked blocked True
home_router_web=all tcp 198.51.100.2 80 blocked blocked True
vpn_peer_web=all tcp 203.0.113.1 80 blocked blocked True
mesh_dns=all tcp 203.0.113.2 53 blocked blocked True
harvested_prefix_host=all tcp 203.0.113.3 443 blocked blocked -
cache_gateway_ssh=runner tcp 10.99.17.1 22 blocked open True
cache_gateway_web_console=runner tcp 10.99.17.1 8006 blocked open True
cache_other_port=runner tcp 10.99.17.10 9092 blocked refused True
