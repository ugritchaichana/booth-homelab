[Unit]
Description=GitHub Actions runner for {{ ci_runner_repository }}
After=network-online.target
Wants=network-online.target

[Service]
User=runner
WorkingDirectory={{ ci_runner_dir }}
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=ACTIONS_RUNNER_HOOK_JOB_STARTED={{ ci_runner_guard }}
Environment=RUNNER_GUARD_REPOSITORY={{ ci_runner_repository }}
ExecStart={{ ci_runner_dir }}/run.sh
Restart=always
RestartSec=10
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
