# Managed by the sim_cache_service role
[Unit]
Description=Sim cache front proxy and tripwire: audit every request, refuse and mark an unauthenticated or unknown-key one
After=network-online.target {{ sim_cache_service_store_unit }}.service
Wants={{ sim_cache_service_store_unit }}.service
RequiresMountsFor={{ sim_cache_service_data_mount }}
OnFailure={{ sim_cache_service_trip_failure_unit }}.service

[Service]
Type=simple
User={{ sim_cache_service_proxy_user }}
Group={{ sim_cache_service_proxy_group }}
ExecStart=/usr/bin/python3 -I {{ sim_cache_service_install_dir }}/tripwire.py --listen 0.0.0.0:{{ sim_cache_service_listen_port }} --upstream 127.0.0.1:{{ sim_cache_service_s3_port }} --state-dir {{ sim_cache_service_state_dir }} --log-file {{ sim_cache_service_log_dir }}/audit.jsonl --log-max-bytes {{ sim_cache_service_tripwire_log_max_bytes }} --allowed-file {{ sim_cache_service_allowed_keys_file }}
Restart=no
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ sim_cache_service_tripwire_dir }} {{ sim_cache_service_log_dir }}
PrivateTmp=true
ProtectHome=true
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=192M

[Install]
WantedBy=multi-user.target
