#!/usr/bin/env bash
# ==============================================================================
# Auto-generated by Ansible - Zero-Trust Netfilter Rules
# Role: enterprise_firewall | Subnet: {{ isolated_subnet }}
# ==============================================================================
set -euo pipefail

# 1. Host Ingress Protection (HOMELAB-INPUT)
iptables -N HOMELAB-INPUT 2>/dev/null || iptables -F HOMELAB-INPUT
if ! iptables -C INPUT -j HOMELAB-INPUT 2>/dev/null; then
    iptables -I INPUT 1 -j HOMELAB-INPUT
fi
iptables -A HOMELAB-INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT
iptables -A HOMELAB-INPUT -i {{ bridge_interface }} -s {{ isolated_subnet }} -d {{ gateway_ip }} -p udp --dport 53 -j ACCEPT
iptables -A HOMELAB-INPUT -i {{ bridge_interface }} -s {{ isolated_subnet }} -d {{ gateway_ip }} -p tcp --dport 53 -j ACCEPT
iptables -A HOMELAB-INPUT -s {{ isolated_subnet }} -p tcp -m multiport --dports 22,8006 -j REJECT --reject-with icmp-port-unreachable

# 2. Flush or Create HOMELAB-FORWARD chain
iptables -N HOMELAB-FORWARD 2>/dev/null || iptables -F HOMELAB-FORWARD

# 3. Domain-fed egress ipset (entries are added by the egress resolver, never by this script)
ipset_header=$(ipset list -t ci-allowed-egress 2>/dev/null || true)
if [[ -n "$ipset_header" && "$ipset_header" != *timeout* ]]; then
    ipset destroy ci-allowed-egress
fi
ipset create -exist ci-allowed-egress hash:ip timeout {{ egress_ipset_timeout }}

# 4. Ensure hook into standard FORWARD chain
if ! iptables -C FORWARD -j HOMELAB-FORWARD 2>/dev/null; then
    iptables -I FORWARD 1 -j HOMELAB-FORWARD
fi

# 5. Allow Established and Related Connections
iptables -A HOMELAB-FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT

# 6. Block East-West Runner-to-Runner Traffic (Port & IP Isolation)
iptables -A HOMELAB-FORWARD -s {{ hostvars['gha-runner-01'].ansible_host | default('10.99.20.101') }} -d {{ hostvars['gha-runner-angular'].ansible_host | default('10.99.20.103') }} -j REJECT --reject-with icmp-host-prohibited
iptables -A HOMELAB-FORWARD -s {{ hostvars['gha-runner-angular'].ansible_host | default('10.99.20.103') }} -d {{ hostvars['gha-runner-01'].ansible_host | default('10.99.20.101') }} -j REJECT --reject-with icmp-host-prohibited

# 7. Allow Runners to Access MinIO S3 API (:{{ minio_api_port | default(9000) }})
iptables -A HOMELAB-FORWARD -s {{ isolated_subnet }} -d {{ hostvars['minio-s3'].ansible_host | default('10.99.20.20') }} -p tcp --dport {{ minio_api_port | default(9000) }} -j ACCEPT

# 8. Block Runners from Accessing MinIO Web Console (:{{ minio_console_port | default(9001) }})
iptables -A HOMELAB-FORWARD -s {{ isolated_subnet }} -d {{ hostvars['minio-s3'].ansible_host | default('10.99.20.20') }} -p tcp --dport {{ minio_console_port | default(9001) }} -j REJECT --reject-with icmp-port-unreachable

# 9. Whitelist Internet Egress (NTP 123 and Domain-Scoped Egress 80/443; DNS is redirected to the host resolver)
iptables -A HOMELAB-FORWARD -s {{ isolated_subnet }} -p udp --dport 123 -j ACCEPT
iptables -A HOMELAB-FORWARD -s {{ isolated_subnet }} -p icmp --icmp-type echo-request -j ACCEPT
iptables -A HOMELAB-FORWARD -s {{ isolated_subnet }} -p tcp -m multiport --dports 80,443 -m set --match-set ci-allowed-egress dst -j ACCEPT

# 10. Log, then Default Deny Egress
iptables -A HOMELAB-FORWARD -s {{ isolated_subnet }} -m limit --limit 10/min --limit-burst 20 -j LOG --log-prefix "{{ egress_deny_log_prefix }} " --log-level 4
iptables -A HOMELAB-FORWARD -s {{ isolated_subnet }} -j DROP

# 11. Force Runner DNS Through the Host Resolver
if ip -4 -o addr show dev {{ bridge_interface }} 2>/dev/null | grep -q " {{ gateway_ip }}/"; then
    for proto in udp tcp; do
        if ! iptables -t nat -C PREROUTING -i {{ bridge_interface }} -s {{ isolated_subnet }} ! -d {{ gateway_ip }} -p "$proto" --dport 53 -j DNAT --to-destination {{ gateway_ip }}:53 2>/dev/null; then
            iptables -t nat -I PREROUTING 1 -i {{ bridge_interface }} -s {{ isolated_subnet }} ! -d {{ gateway_ip }} -p "$proto" --dport 53 -j DNAT --to-destination {{ gateway_ip }}:53
        fi
    done
else
    echo "WARNING: {{ bridge_interface }} has no {{ gateway_ip }}: runner DNS not redirected, runners have no DNS (fail-closed)" >&2
fi

# 12. IPv6 Is Not Provisioned for Runners: Drop It in Both Directions
if [ -e /proc/net/if_inet6 ]; then
    sysctl -w net.bridge.bridge-nf-call-ip6tables=1 >/dev/null 2>&1 || true
    for chain in INPUT FORWARD; do
        ip6tables -N "HOMELAB-${chain}6" 2>/dev/null || ip6tables -F "HOMELAB-${chain}6"
        ip6tables -A "HOMELAB-${chain}6" -j DROP
        if ! ip6tables -C "$chain" -i {{ bridge_interface }} -j "HOMELAB-${chain}6" 2>/dev/null; then
            ip6tables -I "$chain" 1 -i {{ bridge_interface }} -j "HOMELAB-${chain}6"
        fi
    done
fi
