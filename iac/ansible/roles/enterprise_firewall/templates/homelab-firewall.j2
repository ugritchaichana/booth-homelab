#!/usr/bin/env bash
# ==============================================================================
# Auto-generated by Ansible - Zero-Trust Netfilter Rules
# Role: enterprise_firewall | Subnet: {{ isolated_subnet }}
# ==============================================================================
set -euo pipefail

# 1. Flush or Create HOMELAB-FORWARD chain
iptables -N HOMELAB-FORWARD 2>/dev/null || iptables -F HOMELAB-FORWARD

# 2. Ensure hook into standard FORWARD chain
if ! iptables -C FORWARD -j HOMELAB-FORWARD 2>/dev/null; then
    iptables -I FORWARD 1 -j HOMELAB-FORWARD
fi

# 3. Allow Established and Related Connections
iptables -A HOMELAB-FORWARD -m state --state ESTABLISHED,RELATED -j ACCEPT

# 4. Block East-West Runner-to-Runner Traffic (Port & IP Isolation)
iptables -A HOMELAB-FORWARD -s {{ hostvars['gha-runner-01'].ansible_host | default('10.99.20.101') }} -d {{ hostvars['gha-runner-angular'].ansible_host | default('10.99.20.103') }} -j DROP
iptables -A HOMELAB-FORWARD -s {{ hostvars['gha-runner-angular'].ansible_host | default('10.99.20.103') }} -d {{ hostvars['gha-runner-01'].ansible_host | default('10.99.20.101') }} -j DROP

# 5. Allow Runners to Access MinIO S3 API (:{{ minio_api_port | default(9000) }})
iptables -A HOMELAB-FORWARD -s {{ isolated_subnet }} -d {{ hostvars['minio-s3'].ansible_host | default('10.99.20.20') }} -p tcp --dport {{ minio_api_port | default(9000) }} -j ACCEPT

# 6. Block Runners from Accessing MinIO Web Console (:{{ minio_console_port | default(9001) }})
iptables -A HOMELAB-FORWARD -s {{ isolated_subnet }} -d {{ hostvars['minio-s3'].ansible_host | default('10.99.20.20') }} -p tcp --dport {{ minio_console_port | default(9001) }} -j DROP

# 7. Whitelist Internet Egress (DNS 53, HTTP 80, HTTPS 443, NTP 123)
iptables -A HOMELAB-FORWARD -s {{ isolated_subnet }} -p udp --dport 53 -j ACCEPT
iptables -A HOMELAB-FORWARD -s {{ isolated_subnet }} -p tcp --dport 53 -j ACCEPT
iptables -A HOMELAB-FORWARD -s {{ isolated_subnet }} -p tcp --dport 80 -j ACCEPT
iptables -A HOMELAB-FORWARD -s {{ isolated_subnet }} -p tcp --dport 443 -j ACCEPT
iptables -A HOMELAB-FORWARD -s {{ isolated_subnet }} -p udp --dport 123 -j ACCEPT

# 8. Default Deny Egress
iptables -A HOMELAB-FORWARD -s {{ isolated_subnet }} -j DROP
