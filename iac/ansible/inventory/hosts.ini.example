# ==============================================================================
# Homelab Topology Ansible Inventory (Example Template)
# ==============================================================================
# Copy this file to hosts.ini and set the hypervisor IP or mesh address.

[proxmox_node]
pve                ansible_host=<YOUR_PROXMOX_IP_OR_HOSTNAME> ansible_user=root

[ci_runners]
gha-runner-01      ansible_host=10.99.20.101 ansible_user=root vmid=102
gha-runner-angular ansible_host=10.99.20.103 ansible_user=root vmid=103

[s3_cache]
minio-s3           ansible_host=10.99.20.20  ansible_user=root vmid=104

[homelab:children]
proxmox_node
ci_runners
s3_cache
