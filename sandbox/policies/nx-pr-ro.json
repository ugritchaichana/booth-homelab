{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBucketListingAndLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::angular-nx-cache"
      ]
    },
    {
      "Sid": "AllowReadOnlyCacheRetrieval",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::angular-nx-cache/*"
      ]
    }
  ]
}
